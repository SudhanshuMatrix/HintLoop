# HintLoop Configuration Environment Variables

# AI Provider: 'openrouter' | 'groq' | 'ollama' | 'huggingface' | 'google'
AI_PROVIDER=openrouter

# Open-Weight AI Model (Default: gemma-2-9b-it)
AI_MODEL=google/gemma-2-9b-it:free

# API Key for OpenRouter, Groq, or Hugging Face (Leave blank to use built-in local Gemma simulation)
AI_API_KEY=

# Optional custom API base endpoint (e.g. http://localhost:11434/v1 for local Ollama)
# AI_API_BASE=http://localhost:11434/v1
